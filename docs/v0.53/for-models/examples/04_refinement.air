module demo.refine

export func grade(score: i32<0..100>) -> i32<0..4> {
  %pass: bool = i32.ge_s %score, 50
  %g: i32<0..4> = if %pass {
    yield 3
  } else {
    yield 1
  }
  return %g
}

export func to_percent(x: i32) -> i32<0..100> {
  %lo: bool = i32.lt_s %x, 0
  %a: i32 = select.i32 %lo, 0, %x
  %hi: bool = i32.gt_s %a, 100
  %b: i32 = select.i32 %hi, 100, %a
  %r: i32<0..100> = %b
  return %r
}
