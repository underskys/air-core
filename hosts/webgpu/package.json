{
  "name": "airgfx-webgpu",
  "version": "0.10.0",
  "private": true,
  "description": "Browser WebGPU reference host and SDK for AIR GFX v0.10 package modules.",
  "type": "module",
  "scripts": {
    "compile:air": "node ../../bin/airc.js gfx-build ../../examples/gfx_showcase/showcase.air --manifest ../../examples/gfx_showcase/showcase.generated.airgfx.json --out public",
    "check:air": "node ../../bin/airc.js app-check ../../examples/gfx_showcase/showcase.air --manifest ../../examples/gfx_showcase/showcase.generated.airgfx.json",
    "dev": "npm run compile:air && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile:air && npm run typecheck && vite build",
    "smoke": "npm run compile:air && node scripts/smoke.mjs",
    "test": "npm run check:air && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.51",
    "playwright": "1.44.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.3.3",
    "vite": "^4.5.2"
  },
  "engines": {
    "node": ">=16"
  }
}
