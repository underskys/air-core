module network_ipv4_math
capabilities { }
effects { cpu.instructions <= 32 }

func contains(addr: i32, network: i32, mask: i32) -> i32 {
entry:
  %addr_net:i32 = i32.and %addr, %mask
  %net:i32 = i32.and %network, %mask
  %same:bool = i32.eq %addr_net, %net
  %out:i32 = select.i32 %same, 1, 0
  return %out
}

func chunk_end(start: i32, size: i32) -> i32 {
  requires param size >= 1
entry:
  %one:i32 = 1
  %last:i32 = sub %size, %one
  %out:i32 = add %start, %last
  return %out
}

export func run() -> i32 {
entry:
  %addr:i32 = 167772202
  %network:i32 = 167772160
  %mask:i32 = -256
  %hit:i32 = @contains(%addr, %network, %mask)
  %start:i32 = 10
  %size:i32 = 4
  %end:i32 = @chunk_end(%start, %size)
  %score:i32 = add %hit, %end
  return %score
}
