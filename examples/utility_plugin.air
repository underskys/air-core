module utility_plugin
use math.fixed
capabilities { audio, fs, net, random }
effects { fs.exists <= 1, fs.read_file <= 1, net.http_get <= 1, audio.beep <= 1, audio.play_tone <= 1, random.u32 == 1, memory.alloc <= 1, memory.free <= 1, memory.load <= 0, memory.store <= 0, memory.static_alloc_bytes <= 256, memory.dynamic_allocations <= 0 }
requires export run

extern fs.exists(path_ptr: i32, path_len: i32) -> bool
extern fs.read_file(path_ptr: i32, path_len: i32, out_ptr: ptr, max_len: i32) -> i32
extern net.http_get(url_ptr: i32, url_len: i32, out_ptr: ptr, max_len: i32) -> i32
extern random.u32() -> i32
extern audio.beep(id: i32) -> void
extern audio.play_tone(freq: f32, duration_ms: i32) -> void

export func run() -> i32 {
entry:
  %path_ptr:i32 = 2048
  %path_len:i32 = 12
  %url_ptr:i32 = 2304
  %url_len:i32 = 18
  %bytes:i32 = 256
  %buf:ptr = alloc_region %bytes
  %exists:bool = @fs.exists(%path_ptr, %path_len)
  %read:i32 = @fs.read_file(%path_ptr, %path_len, %buf, %bytes)
  %net:i32 = @net.http_get(%url_ptr, %url_len, %buf, %bytes)
  %seed:i32 = @random.u32()
  %zero:i32 = 0
  %hi:i32 = 10000
  %read_pos:i32 = fixed.clamp_i32 %read, %zero, %hi
  %net_pos:i32 = fixed.clamp_i32 %net, %zero, %hi
  %mask:i32 = 1023
  %seed_small:i32 = i32.and %seed, %mask
  %freq:f32 = 440.0
  %dur:i32 = 20
  %beep_id:i32 = 1
  @audio.beep(%beep_id)
  @audio.play_tone(%freq, %dur)
  %one:i32 = 1
  %exists_i:i32 = select.i32 %exists, %one, %zero
  %sum:i32 = add %read_pos, %net_pos
  %with_exists:i32 = add %sum, %exists_i
  %out:i32 = add %with_exists, %seed_small
  free_region %buf
  return %out
}
