module airops_incident_canonical
const SCORE_MAX:i32 = 100
const ACTION_SCALE:i32 = 10000
const RISK_SCALE:i32 = 100
const LATENCY_FLAG:i32 = 1
const ERROR_FLAG:i32 = 2
const LATENCY_BIT_SCALE:i32 = 2
const ERROR_BIT_SCALE:i32 = 4
const LOW_CONFIDENCE_BIT_SCALE:i32 = 8
table root_kind_by_flags:i32[8] = [100, 103, 101, 101, 102, 102, 102, 102]
table action_by_state:i32[16] = [203, 202, 201, 201, 204, 204, 204, 204, 205, 205, 205, 205, 205, 205, 205, 205]
capabilities { }

func clamp_nonnegative(value: i32) -> i32 {
entry:
  %zero:bool = i32.lt_s %value, 0
  %out:i32 = select.i32 %zero, 0, %value
  return %out
}

func clamp_100(value: i32) -> i32 {
entry:
  %positive:i32 = @clamp_nonnegative(%value)
  %too_high:bool = i32.gt_s %positive, SCORE_MAX
  %out:i32 = select.i32 %too_high, SCORE_MAX, %positive
  return %out
}

func bit_i32(value: bool) -> i32 {
entry:
  %out:i32 = select.i32 %value, 1, 0
  return %out
}

export func root_cause_kind_id(flags: i32, signal_count: i32) -> i32 {
entry:
  %error_mask:i32 = i32.and %flags, ERROR_FLAG
  %has_errors:bool = i32.ne %error_mask, 0
  %latency_mask:i32 = i32.and %flags, LATENCY_FLAG
  %has_latency:bool = i32.ne %latency_mask, 0
  %many_signals:bool = i32.gt_s %signal_count, 6
  %many_bit:i32 = @bit_i32(%many_signals)
  %latency_raw:i32 = @bit_i32(%has_latency)
  %latency_bit:i32 = mul %latency_raw, LATENCY_BIT_SCALE
  %error_raw:i32 = @bit_i32(%has_errors)
  %error_bit:i32 = mul %error_raw, ERROR_BIT_SCALE
  %base_index:i32 = add %many_bit, %latency_bit
  %index:i32 = add %base_index, %error_bit
  %out:i32 = table.get root_kind_by_flags, %index
  return %out
}

export func risk_score(severity_id: i32, signal_count: i32, age_minutes: i32, flags: i32) -> i32 {
entry:
  %safe_severity:i32 = @clamp_100(%severity_id)
  %safe_signals:i32 = @clamp_100(%signal_count)
  %safe_age:i32 = @clamp_100(%age_minutes)
  %sev_weight:i32 = mul %safe_severity, 18
  %signal_weight:i32 = mul %safe_signals, ERROR_BIT_SCALE
  %age_weight:i32 = i32.div_s %safe_age, 5
  %flag_errors:i32 = i32.and %flags, ERROR_FLAG
  %has_errors:bool = i32.ne %flag_errors, 0
  %flag_bonus:i32 = select.i32 %has_errors, 10, 0
  %base:i32 = add %sev_weight, %signal_weight
  %aged:i32 = add %base, %age_weight
  %raw:i32 = add %aged, %flag_bonus
  %out:i32 = @clamp_100(%raw)
  return %out
}

export func confidence_score(signal_count: i32, age_minutes: i32) -> i32 {
entry:
  %safe_signals:i32 = @clamp_100(%signal_count)
  %safe_age:i32 = @clamp_100(%age_minutes)
  %signal_weight:i32 = mul %safe_signals, 5
  %age_penalty:i32 = i32.div_s %safe_age, 3
  %raw_base:i32 = add 45, %signal_weight
  %raw:i32 = sub %raw_base, %age_penalty
  %out:i32 = @clamp_100(%raw)
  return %out
}

export func recommended_action_id(root_cause_kind: i32, risk: i32, confidence: i32) -> i32 {
entry:
  %high_risk:bool = i32.ge_s %risk, 90
  %medium_risk:bool = i32.ge_s %risk, 60
  %low_confidence:bool = i32.lt_s %confidence, 50
  %is_error:bool = i32.eq %root_cause_kind, 102
  %medium_raw:i32 = @bit_i32(%medium_risk)
  %high_raw:i32 = @bit_i32(%high_risk)
  %high_bit:i32 = mul %high_raw, LATENCY_BIT_SCALE
  %error_raw:i32 = @bit_i32(%is_error)
  %error_bit:i32 = mul %error_raw, ERROR_BIT_SCALE
  %low_confidence_raw:i32 = @bit_i32(%low_confidence)
  %low_confidence_bit:i32 = mul %low_confidence_raw, LOW_CONFIDENCE_BIT_SCALE
  %risk_index:i32 = add %medium_raw, %high_bit
  %error_index:i32 = add %risk_index, %error_bit
  %index:i32 = add %error_index, %low_confidence_bit
  %out:i32 = table.get action_by_state, %index
  return %out
}

export func bounded_command_intent(incident_id: i32, severity_id: i32, signal_count: i32, age_minutes: i32, flags: i32) -> i32 {
entry:
  %root:i32 = @root_cause_kind_id(%flags, %signal_count)
  %risk:i32 = @risk_score(%severity_id, %signal_count, %age_minutes, %flags)
  %confidence:i32 = @confidence_score(%signal_count, %age_minutes)
  %action:i32 = @recommended_action_id(%root, %risk, %confidence)
  %incident_low:i32 = i32.and %incident_id, 1023
  %action_slot:i32 = mul %action, ACTION_SCALE
  %risk_slot:i32 = mul %risk, RISK_SCALE
  %action_risk:i32 = add %action_slot, %risk_slot
  %out:i32 = add %action_risk, %incident_low
  return %out
}
