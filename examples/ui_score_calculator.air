module ui_score_calculator
capabilities { ui }
effects { ui.* <= 11 }
requires capability ui
requires export render

extern ui.begin_frame(width: i32, height: i32, time_ms: i32) -> void
extern ui.panel(id: i32, x: i32, y: i32, w: i32, h: i32, style: i32) -> void
extern ui.label(id: i32, x: i32, y: i32, label: i32, style: i32) -> void
extern ui.input_i32(id: i32, x: i32, y: i32, w: i32, label: i32, value: i32, style: i32) -> i32
extern ui.button(id: i32, x: i32, y: i32, w: i32, h: i32, label: i32, style: i32) -> bool
extern ui.metric(id: i32, x: i32, y: i32, label: i32, value: i32, unit: i32, style: i32) -> void
extern ui.bar(id: i32, x: i32, y: i32, w: i32, value: i32, max: i32, style: i32) -> void
extern ui.status(id: i32, x: i32, y: i32, label: i32, severity: i32, style: i32) -> void
extern ui.end_frame() -> void

export func render(default_a: i32, default_b: i32, default_bonus: i32) -> i32 {
entry:
  @ui.begin_frame(640, 480, 0)
  @ui.panel(1, 24, 24, 440, 360, 1)
  @ui.label(2, 48, 48, 1100, 1)
  %a:i32 = @ui.input_i32(3, 48, 96, 260, 1101, %default_a, 1)
  %b:i32 = @ui.input_i32(4, 48, 144, 260, 1102, %default_b, 1)
  %bonus:i32 = @ui.input_i32(5, 48, 192, 260, 1103, %default_bonus, 1)
  %sum:i32 = add %a, %b
  %with_bonus:i32 = add %sum, %bonus
  %reset:bool = @ui.button(6, 48, 248, 160, 40, 1104, 1)
  %zero:i32 = 0
  %total:i32 = select.i32 %reset, %zero, %with_bonus
  @ui.metric(7, 48, 304, 1105, %total, 2003, 1)
  @ui.bar(8, 48, 344, 320, %total, 100, 1)
  %over_limit:bool = i32.gt_s %total, 100
  %severity:i32 = select.i32 %over_limit, 2, 0
  @ui.status(9, 240, 256, 1106, %severity, 1)
  @ui.end_frame()
  return %total
}
