module static_tables
table thresholds:i32[3] = [25, 50, 75]
table weights:f32[3] = [0.25, 0.5, 1.0]
capabilities { }

export func threshold(index: i32) -> i32 {
entry:
  %value:i32 = table.get thresholds, %index
  return %value
}

export func weight(index: i32) -> f32 {
entry:
  %value:f32 = table.get weights, %index
  return %value
}
