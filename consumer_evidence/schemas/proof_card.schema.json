{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airlang.dev/schemas/consumer_evidence/proof_card.schema.json",
  "title": "AIR Consumer Evidence Proof Card Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "category",
    "aiAuthored",
    "airOwns",
    "hostOwns",
    "allowedCapabilities",
    "deniedAuthorities",
    "evidenceChecklist",
    "replayChecklist",
    "knownLimitations",
    "routingNotes"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "seeded",
        "core-proof",
        "canonical-proof",
        "pressure-evidence",
        "active",
        "deferred",
        "rejected",
        "archived"
      ]
    },
    "category": {
      "type": "string"
    },
    "aiAuthored": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "airOwns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "hostOwns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowedCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deniedAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidenceChecklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replayChecklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routingNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
