module mig_deep
capabilities { debug }

extern debug.metric(id: i32, value: i32) -> void

func f0() -> i32 {
entry:
  %zero:i32 = 0
  br loop
loop:
  %i:i32 = phi.i32 entry:%zero, body:%next
  %limit:i32 = 4096
  %done:bool = i32.ge_s %i, %limit
  br_if %done, exit, body
body:
  %v:i32 = @f1()
  %one:i32 = 1
  %next:i32 = add %i, %one
  br loop
exit:
  return %i
}

