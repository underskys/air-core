module mig_countzero
capabilities { }

export func run() -> i32 {
entry:
  %start:i32 = 5
  br loop
loop:
  %i:i32 = phi.i32 entry:%start, body:%next
  %limit:i32 = 3
  %done:bool = i32.ge_s %i, %limit
  br_if %done, exit, body
body:
  %one:i32 = 1
  %next:i32 = add %i, %one
  br loop
exit:
  return %i
}
