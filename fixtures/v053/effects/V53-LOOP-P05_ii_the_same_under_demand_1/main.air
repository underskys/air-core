module v53.loop
capabilities { output }
demand { output.emit <= 1 }

extern output.emit(output_id: i32, arg0: i32, arg1: i32, arg2: i32, arg3: i32) -> i32

func emit_once(acc: i32) -> i32 {
  %s: i32 = call @output.emit(1, %acc, 0, 0, 0)
  %o: i32 = i32.wrapping_add %acc, 1
  return %o
}

export func run() -> i32 {
  %r: i32 = loop.fold @emit_once, 0, 100
  return %r
}
