module v53.eff
capabilities { debug, input, random }
demand { debug.metric <= 1, input.button <= 1, random.u32 <= 1 }

extern debug.metric(id: i32, value: i32) -> void
extern input.button(id: i32) -> bool
extern random.u32() -> i32

export func b(i: i32) -> bool {
  %v: bool = call @input.button(%i)
  return %v
}

export func d(x: i32) -> i32 {
  call @debug.metric(1, %x)
  return %x
}

export func u() -> i32 {
  %v: i32 = call @random.u32()
  return %v
}
