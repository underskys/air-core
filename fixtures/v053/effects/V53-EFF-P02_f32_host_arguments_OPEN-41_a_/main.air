module v53.eff
capabilities { audio }
demand { audio.play_tone <= 1, audio.set_gain <= 1 }

extern audio.play_tone(freq: f32, ms: i32) -> void
extern audio.set_gain(gain: f32) -> void

export func g(x: f32) -> i32 {
  call @audio.set_gain(%x)
  call @audio.play_tone(%x, 5)
  return 0
}

export func h(x: f32) -> i32 {
  %n: f32 = f32.sub %x, %x
  call @audio.set_gain(%n)
  return 0
}
