module physics
capabilities { }

func clamp_i32(v: i32, min: i32, max: i32) -> i32 {
entry:
  %too_low:bool = i32.lt_s %v, %min
  %low:i32 = select.i32 %too_low, %min, %v
  %too_high:bool = i32.gt_s %low, %max
  %out:i32 = select.i32 %too_high, %max, %low
  return %out
}

func damp_i32(current: i32, target: i32, keep: i32, accel: i32, div: i32) -> i32 {
  requires param div >= 1
entry:
  %out:i32 = physics.damp_i32 %current, %target, %keep, %accel, %div
  return %out
}

func grounded_i32(y: i32, ground: i32, vy: i32, pad: i32) -> bool {
  requires param pad >= 0
entry:
  %out:bool = physics.grounded_i32 %y, %ground, %vy, %pad
  return %out
}

func snap_y_i32(y: i32, ground: i32, vy: i32, pad: i32) -> i32 {
  requires param pad >= 0
entry:
  %out:i32 = physics.snap_y_i32 %y, %ground, %vy, %pad
  return %out
}

func snap_vy_i32(y: i32, ground: i32, vy: i32, pad: i32) -> i32 {
  requires param pad >= 0
entry:
  %out:i32 = physics.snap_vy_i32 %y, %ground, %vy, %pad
  return %out
}

func inside_box(px: i32, pz: i32, min_x: i32, max_x: i32, min_z: i32, max_z: i32) -> bool {
entry:
  %ge_min_x:bool = i32.ge_s %px, %min_x
  %le_max_x:bool = i32.le_s %px, %max_x
  %in_x:bool = bool.and %ge_min_x, %le_max_x
  %ge_min_z:bool = i32.ge_s %pz, %min_z
  %le_max_z:bool = i32.le_s %pz, %max_z
  %in_z:bool = bool.and %ge_min_z, %le_max_z
  %inside:bool = bool.and %in_x, %in_z
  return %inside
}

func capsule_aabb_hit(px: i32, py: i32, pz: i32, radius: i32, bottom_drop: i32, top_rise: i32, min_x: i32, max_x: i32, min_y: i32, max_y: i32, min_z: i32, max_z: i32) -> bool {
  requires param radius >= 0
  requires param bottom_drop >= 0
  requires param top_rise >= 0
entry:
  %expanded_min_x:i32 = sub %min_x, %radius
  %expanded_max_x:i32 = add %max_x, %radius
  %expanded_min_z:i32 = sub %min_z, %radius
  %expanded_max_z:i32 = add %max_z, %radius
  %in_xz:bool = @inside_box(%px, %pz, %expanded_min_x, %expanded_max_x, %expanded_min_z, %expanded_max_z)
  %body_bottom:i32 = sub %py, %bottom_drop
  %body_top:i32 = add %py, %top_rise
  %top_hits:bool = i32.ge_s %body_top, %min_y
  %bottom_hits:bool = i32.le_s %body_bottom, %max_y
  %overlap_y:bool = bool.and %top_hits, %bottom_hits
  %hit:bool = bool.and %in_xz, %overlap_y
  return %hit
}
